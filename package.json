{
  "name": "vtcoon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/server/index.ts --outDir dist/server",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "tunnel": "docker run --rm -it --name vtcoon_tunnel --network vtcoon_internal cloudflare/cloudflared:latest tunnel --no-autoupdate --url http://nginx:80",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chaos": "cross-env CHAOS_GAMES=1000 vitest run tests/simulation/chaos_monkey_simulator.test.ts",
    "benchmark:trends": "npx tsx scripts/benchmark_gameplay_trends.ts",
    "test:uat": "vitest run --config vitest.uat.config.ts",
    "lint:ui": "node scripts/lint_ui.mjs",
    "lint:slop": "node scripts/lint_slop.mjs",
    "lint:dup": "jscpd src/ --config .jscpd.json",
    "lint:assets": "node scripts/optimize_assets.mjs",
    "gate:quick": "npm run lint:ui && npm run lint:slop && npm run lint:dup && npm run lint:assets && tsc --noEmit",
    "gate": "npm run lint:ui && npm run lint:slop && npm run lint:dup && npm run lint:assets && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.175.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "howler": "^2.2.4",
    "jscpd": "^5.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.175.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@react-three/postprocessing": "^3.1.1",
    "postprocessing": "^6.39.5",
    "ws": "^8.21.3"
  }
}
