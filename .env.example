PORT=3000
WSS_PORT=3001
GRACE_PERIOD_MS=60000
VTCOON_ADMIN_SECRET=           # Mật mã quản trị viên (BẮT BUỘC khi NODE_ENV=production)
ADMIN_SECRET=                  # Bí danh tương đương cho VTCOON_ADMIN_SECRET
ALLOWED_ORIGINS=               # Comma-separated origins cho WebSocket (production)
MAX_CONCURRENT_ROOMS=50        # Giới hạn phòng đồng thời (mặc định: 50)
NGROK_AUTHTOKEN=               # Token ngrok (không commit)
NGROK_DOMAIN=                  # Domain ngrok
